# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gearup?schema=public

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma separated
APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe returns customers (defaults to <first APP_URL>/payment/success|cancel)
CLIENT_SUCCESS_URL=http://localhost:3000/payment/success
CLIENT_CENCEL_URL=http://localhost:3000/payment/cancel

# Cloudinary (gear image uploads)
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret

# Seed admin (npm run seed)
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
